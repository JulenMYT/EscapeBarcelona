  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Clima mediterr\xE1neo, espl\xE9ndidas playas, dinamismo y gastronom\xEDa,
    Barcelona ofrece multitud de oportunidades y un entorno de vida excepcional.\nBarcelona
    capital de Catalu\xF1a\nSituada en el sureste de Espa\xF1a, en la regi\xF3n catalana,
    Barcelona es la ciudad m\xE1s activa y din\xE1mica. Bordeado por el mar Mediterr\xE1neo
    y disfrutando de un clima suave y agradable, solo puede dejarse seducir por la
    ciudad y lo que tiene para ofrecer. Los paisajes son impresionantes. Usted puede
    disfrutar de una vista impresionante de la ciudad desde las monta\xF1as, as\xED
    como kil\xF3metros de playas para relajarse. \xBFAmantes de la naturaleza? Encontrar\xE1s
    muchos parques para pasear y disfrutar de hermosas puestas de sol.\nLa ciudad
    est\xE1 compuesta por diferentes barrios muy diferentes entre s\xED. Ir\xE1s
    desde el aut\xE9ntico Barrio G\xF3tico a Barceloneta, un distrito activo y tur\xEDstico
    donde podr\xE1s relajarte con especialidades locales frente al mar."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5302535af1044152a457ed104f1f4b91, type: 2}
  m_sharedMaterial: {fileID: 2164040, guid: 5302535af1044152a457ed104f1f4b91, type: 2}
